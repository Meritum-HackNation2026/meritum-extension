{
  "name": "meritum-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Meritum: wtyczka Chrome (MV3)",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/setup-dom.ts --test '{entrypoints,tests,utils}/**/*.test.{ts,tsx}'",
    "depcruise": "depcruise entrypoints utils --config .dependency-cruiser.cjs",
    "knip": "knip",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "dependency-cruiser": "^18.8.0",
    "knip": "^6.47.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "packageManager": "pnpm@12.21.0"
}
