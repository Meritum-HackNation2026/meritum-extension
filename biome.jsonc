{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/dist",
      "!!.output",
      "!!.wxt",
      "!entrypoints/popup/ui.css",
      "!entrypoints/popup/popup.css",
      // read-only copy from meritum-design-system (pnpm sync); its sums are checked in pnpm test
      "!design-system"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noEmptyBlockStatements": "error",
        "useAwait": "error",
        "noEvolvingTypes": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "useCollapsedElseIf": "error",
        "noUselessElse": "error"
      },
      "complexity": {
        "preset": "all",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useLiteralKeys": "off"
      },
      "performance": {
        "preset": "all"
      },
      "security": {
        "preset": "all"
      }
    }
  },
  "overrides": [
    {
      // A slice's index.ts is its public API (meritum-architecture rule 1), not a barrel to avoid.
      "includes": ["utils/*/index.ts"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
